APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_THEME=pterodactyl
APP_TIMEZONE=UTC
APP_URL=http://panel.example.com
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=true

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=pterodactyl
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

HASHIDS_SALT=
HASHIDS_LENGTH=8

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Pterodactyl Panel"
# You should set this to your domain to prevent it defaulting to 'localhost', causing
# mail servers such as Gmail to reject your mail.
#
# @see: https://github.com/pterodactyl/panel/pull/3110
# MAIL_EHLO_DOMAIN=panel.example.com

# Beacon Panel extensions. Self-service provisioning remains disabled unless explicitly enabled.
BEACON_SELF_SERVICE_ENABLED=false
BEACON_MINECRAFT_VERSIONS=1.21.8,1.21.4,1.20.4,1.20.1
BEACON_API_RATELIMIT=60
BEACON_API_RATELIMIT_PERIOD=1
BEACON_CONTENT_RATELIMIT=20
BEACON_CONTENT_RATELIMIT_PERIOD=1
BEACON_POLL_RATELIMIT=120
BEACON_POLL_RATELIMIT_PERIOD=1
BEACON_MODRINTH_USER_AGENT=PuShitcake/BeaconPanel
BEACON_MODRINTH_TIMEOUT=10
BEACON_MODRINTH_CACHE_TTL=300
BEACON_CONTENT_MAX_FILE_BYTES=268435456
BEACON_CONTENT_MAX_TOTAL_BYTES=536870912
BEACON_CONTENT_MAX_DEPENDENCIES=50
BEACON_CONTENT_MAX_DEPENDENCY_DEPTH=8
BEACON_CONTENT_REQUIRE_STOPPED_SERVER=true
BEACON_CONTENT_BACKUP_BEFORE_MUTATION=true
BEACON_CONFIG_REQUIRE_STOPPED_SERVER=true
# Enable after migrations, a queue worker, compatible runtime Eggs, and live Wings rollback have been verified.
BEACON_MODPACKS_ENABLED=false
BEACON_MODPACK_MAX_ARCHIVE_BYTES=2147483648
BEACON_MODPACK_MAX_EXTRACTED_BYTES=8589934592
BEACON_MODPACK_OPERATION_TIMEOUT=60
BEACON_MODPACK_POWER_TIMEOUT=120
BEACON_CURSEFORGE_API_KEY=
BEACON_TECHNIC_BUILD=multimc
BEACON_VOIDSWRATH_ENABLED=false
BEACON_EGG_VANILLA="Vanilla Minecraft"
BEACON_EGG_PAPER="Paper"
BEACON_EGG_FABRIC="Vanilla Minecraft"
BEACON_EGG_FORGE="Forge Minecraft"
BEACON_EGG_NEOFORGE="Forge Minecraft"
BEACON_EGG_QUILT="Vanilla Minecraft"
